# Copy to `.env` and adjust. Validated by `src/config/env.ts` at startup — a
# missing or malformed value stops the process with a readable message.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on.
PORT=8000

# error | warn | info | http | verbose | debug | silly
# Defaults to `debug` in development and `info` in production.
# LOG_LEVEL=debug

# Comma-separated browser origins allowed to call this API (CORS). The Next.js
# dev server is allowed by default; add the deployed web origin in production.
CORS_ORIGIN=http://localhost:3000
