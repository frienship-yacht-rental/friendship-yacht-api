# Copy to `.env` and adjust. Validated by `src/config/env.ts` at startup — a
# missing or malformed value stops the process with a readable message.

# Port
PORT=8000

# CORS: comma-separated browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Rate limiting for /api routes: requests per window, per client IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Proxy: true when behind a load balancer / reverse proxy.
TRUST_PROXY=false

# Database
DATABASE_URL=mysql://user:password@127.0.0.1:3306/friendship-yachts

# Better Auth: secret must be at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:8000
